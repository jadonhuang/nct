@model PageResult

@{


    string pageParam = "pageIndex";

    var pageNum = Model.PageNum;

    int showPages = 10;

    int preNum = (showPages - 1) / 2;

    int start = Model.PageIndex - preNum;

    if (start < 1) start = 1;

    int end = start + showPages - 1;

    if (end > pageNum) end = pageNum;

    if ((end - start + 1) < showPages) start = 1;

    var pageIndex = Model.PageIndex;

    var path = Context.Request.Path;

    var query = Context.Request.Query;

    string queryStr = "";

    foreach (var kv in query)
    {
        if (!kv.Key.IgnoreCaseEqual(pageParam))
        {
            queryStr += $"{kv.Key}={kv.Value}&";
        }
    }

    queryStr = "?" + queryStr+ pageParam + "=";

    var pageStr = path.Value + queryStr;


}

@if (pageNum > 1)
{
    <div class="pager">

        @for (var index = start; index <= end; index++)
        {
            if (index == pageIndex)
            {
                <a class="cur">@index</a>
            }
            else
            {
                <a href="@(pageStr+index)">@index</a>
            }

        }

        @if (pageIndex != pageNum)
        {

            <a href="@(pageStr+(pageIndex+1))">下一页</a>
        }




        <span>当前第 <b>@pageIndex</b>页，总共<b>@pageNum</b>页记录</span>
    </div>

}
